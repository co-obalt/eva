# This is the .env file structure you have to follow. 
# The preference is always to be effiencet, less token consumption, effective. Cuz we're using free models/things here.

# Groq High-Speed Neural API (Primary Provider)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# APINEX API Configurations (Secondary Proxy Provider - 5 RPM Limit Aware)
APINEX_API_KEY=
APINEX_BASE_URL=https://apinex.bond/v1
APINEX_RPM_LIMIT=5

# OpenAI-Compatible Default Endpoints
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
JARVIS_API_KEY=
